         <photoshop:ColorMode>3</photoshop:ColorMode>
         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>CONTACT: For any asset related issue please contact me at : rug</photoshop:LayerName>
                  <photoshop:LayerText>CONTACT: For any asset related issue please contact me at : ruggero.corridori@gmail.com Like our works? Need a custom project? Contact us to info@OneirosVr.com for a free quote.     </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>VIRTUAL REALITY: Project Settings: Be sure to check the ‚ÄúVirtua</photoshop:LayerName>
                  <photoshop:LayerText>VIRTUAL REALITY: Project Settings: Be sure to check the ‚ÄúVirtual Reality Supported‚Äù (Edit/Project Settings/Other Settings). Also to boost performance use ‚ÄúSingle Stereo pass‚Äù.  </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>RenderScale: As additional settings use the ‚ÄúExampleRenderScale</photoshop:LayerName>
                  <photoshop:LayerText>RenderScale: As additional settings use the ‚ÄúExampleRenderScale‚Äù script on the ‚ÄúMANAGER‚Äù Gameobject. Default value is 1, use higher value to increase rendering quality in VR (antialiasing). ATTENTION, high value will decrease performance significatively.     </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>POSTPROCESSING: ArchVizPRO Interior Vol.4 use the new Post Proc</photoshop:LayerName>
                  <photoshop:LayerText>POSTPROCESSING: ArchVizPRO Interior Vol.4 use the new Post Proccesing Stack effects. Be sure to download latest version from:  https://www.assetstore.unity3d.com/en/#!/content/83912 Use the right  profile one on you camera, depending on your Build Target       </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>BAKED GI: ArchVizPRO Interior Vol.4 use Baked GI. First time yo</photoshop:LayerName>
                  <photoshop:LayerText>BAKED GI: ArchVizPRO Interior Vol.4 use Baked GI. First time you open the project Unity will compute Global Illumination (30 minutes more or less depending on your hardware). Wait untill the blue bar at the bottom disappear... then you are ready to go!            Also be sure that ‚ÄúAuto‚Äù (Window/Lighting) is enabled:</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Baked Global Illumination</photoshop:LayerName>
                  <photoshop:LayerText>Baked Global Illumination</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>AVP_Mobile (Android/IOS): Suggested settings: Edit/Project Sett</photoshop:LayerName>
                  <photoshop:LayerText>AVP_Mobile (Android/IOS): Suggested settings: Edit/Project Settings/Player: Forward Edit/project Settings/Quality: AVP4_Mobile  </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>For Mobile is highly recommended to decrease texture size. Half</photoshop:LayerName>
                  <photoshop:LayerText>For Mobile is highly recommended to decrease texture size. Half or Quarter texture size depending on your hardware. If you manually reduce texture size leave Texture Quality at Full Res</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>AVP_VR (Vive/Oculus): Suggested settings: Edit/Project Settings</photoshop:LayerName>
                  <photoshop:LayerText>AVP_VR (Vive/Oculus): Suggested settings: Edit/Project Settings/Player: Forward and Linear Edit/project Settings/Quality: AVP4_VR   </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Htc Vive: Download SteamVR from Asset store. Drag 3D PREFAB/Pla copy</photoshop:LayerName>
                  <photoshop:LayerText>Htc Vive: Download SteamVR from Asset store. Drag 3D PREFAB/Player/Player_Vive on House floor. OCULUS: Drag 3d PREFAB/Player/Player_Oculus on house floor</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>AVP_Standard (Windows/MacOS): Suggested settings: Edit/Project </photoshop:LayerName>
                  <photoshop:LayerText>AVP_Standard (Windows/MacOS): Suggested settings: Edit/Project Settings/Player: Deferred and Linear Edit/project Settings/Quality: AVP4_Standard  </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Standard: Character controller is already in the scene. Press p</photoshop:LayerName>
                  <photoshop:LayerText>Standard: Character controller is already in the scene. Press play and start your walktrough</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>QUALITY SETTINGS: You can import predade quality settings, alre</photoshop:LayerName>
                  <photoshop:LayerText>QUALITY SETTINGS: You can import predade quality settings, already setup for different target devices. Extract the QualitySettings.zip (located in main Asset/ folder) into your ProjectSettings folder. If prompted, click yes and replace the existing one.  </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>PROJECT SETUP: ArchVizPRO Interior Vol.4 is optimized to run on</photoshop:LayerName>
                  <photoshop:LayerText>PROJECT SETUP: ArchVizPRO Interior Vol.4 is optimized to run on many platform. Chose the right scene file depending on your target machine.   </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>AVP4_Standard (Windows/MacOS) AVP4_VR (Vive/Oculus) AVP4_Mobile</photoshop:LayerName>
                  <photoshop:LayerText>AVP4_Standard (Windows/MacOS) AVP4_VR (Vive/Oculus) AVP4_Mobile (GearVR/Daydream/Android/IOS)</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>QUICK START: 1- Create a New Project 2- Import  ArchVizPRO Vol.</photoshop:LayerName>
                  <photoshop:LayerText>QUICK START: 1- Create a New Project 2- Import  ArchVizPRO Vol.4 3- Import Quality Settings (Assets\ArchVizPRO Interior Vol.4\QualitySettings.zip) 4- Import Character Controller (Asset/Import Package/Character) 5- Import Post Processing Stack (https://www.assetstore.unity3d.com/en/#!/content/83912) </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>ArchVizPRO Interior Vol.4</photoshop:LayerName>
                  <photoshop:LayerText>ArchVizPRO Interior Vol.4</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>
         <photoshop:DocumentAncestors>
            <rdf:Bag>
