    <ui:VisualElement style="background-image: url(&apos;project://database/Assets/Editor/UI/Images/Main%20content.png?fileID=2800000&amp;guid=42c4421b798704542890bff0990d7c95&amp;type=3#Main content&apos;); background-color: rgb(0, 0, 0); border-top-left-radius: 1px; border-bottom-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; -unity-background-scale-mode: scale-and-crop; -unity-background-image-tint-color: rgb(255, 255, 255); height: 100%;">
        <ui:VisualElement style="background-image: url(&apos;project://database/Assets/Editor/UI/Images/Banter_No_Background.png?fileID=2800000&amp;guid=301adb4a09caf6a4c90556f46a4505db&amp;type=3#Banter_No_Background&apos;); width: auto; height: 200px; -unity-background-scale-mode: scale-and-crop;" />
        <ui:Label text="BANTER SDK UI COMPONENTS" display-tooltip-when-elided="true" class="unity-label-margin" style="margin-top: 10px; font-size: 18px; -unity-text-align: upper-center; -unity-font-style: bold;" />
        <ui:ScrollView horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Auto" style="height: 100%; background-image: none; background-color: rgba(0, 0, 0, 0);">
            <ui:Button text="BUTTON" display-tooltip-when-elided="true" name="NewButton" />
            <ui:Toggle label="Toggle" focusable="true" value="true" />
            <ui:TextField picking-mode="Ignore" label="Text Field" value="filler text" text="filler text" focusable="true" />
            <ui:ProgressBar title="DOWNLOADING..." focusable="true" value="45" progress="60" high-value="100" low-value="40" />
            <uie:Vector2Field label="Vec2 Field" focusable="true" />
            <uie:Vector3Field label="Vec3 Field" focusable="true" />
            <uie:Vector4Field label="Vec4 Field" focusable="true" />
            <ui:DropdownField label="Dropdown" index="-1" choices="Hi, Hello, here, come-on" focusable="true" />
            <uie:EnumField label="Enum" value="Center" focusable="true" />
            <uie:TagField label="Tag" value="Player" focusable="true" />
            <uie:MaskField label="Mask" choices="System.Collections.Generic.List`1[System.String]" focusable="true" />
