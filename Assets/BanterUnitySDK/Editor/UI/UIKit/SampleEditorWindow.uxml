            <uie:ObjectField label="Object Field" type="UnityEngine.Texture2D, UnityEngine.CoreModule" />
            <ui:Foldout text="Foldout 1" value="false">
                <ui:Button text="BUTTON" display-tooltip-when-elided="true" name="NewButton" />
                <ui:ProgressBar title="DOWNLOADING..." focusable="true" value="45" progress="60" high-value="100" low-value="40" />
                <ui:Foldout text="Foldout 1.1" value="true">
                    <ui:Button text="BUTTON" display-tooltip-when-elided="true" name="NewButton" />
                    <ui:TextField picking-mode="Ignore" label="Text Field" value="filler text" text="filler text" focusable="true" />
                </ui:Foldout>
                <ui:Foldout text="Foldout 1.2" value="true">
                    <ui:Button text="BUTTON" display-tooltip-when-elided="true" name="NewButton" />
                    <ui:ProgressBar title="DOWNLOADING..." focusable="true" value="45" progress="60" high-value="100" low-value="15" />
                </ui:Foldout>
                <ui:Foldout text="Foldout 1.3" value="true">
                    <ui:TextField picking-mode="Ignore" label="Text Field" value="filler text" text="filler text" focusable="true" />
                    <ui:ProgressBar title="SAVING..." focusable="true" value="25" progress="60" high-value="100" low-value="55" />
                </ui:Foldout>
                <ui:Foldout text="Foldout 1.4" value="true">
                    <ui:Button text="BUTTON" display-tooltip-when-elided="true" name="NewButton" />
                    <ui:ProgressBar title="UPLOADING..." focusable="true" value="15" progress="60" high-value="100" low-value="7" />
                </ui:Foldout>
                <ui:Foldout text="Foldout 1.5" value="true">
                    <ui:Button text="BUTTON" display-tooltip-when-elided="true" name="NewButton" />
                    <ui:ProgressBar title="DELETING..." focusable="true" value="55" progress="60" high-value="100" low-value="25" />
                </ui:Foldout>
            </ui:Foldout>
            <ui:Slider picking-mode="Ignore" label="Slider" value="42" high-value="100" focusable="true" show-input-field="true" style="margin-left: 12px; margin-right: 12px; margin-top: 5px; margin-bottom: 5px;" />
            <ui:MinMaxSlider picking-mode="Ignore" label="Min/Max Slider" min-value="10" max-value="12" low-limit="-10" high-limit="40" focusable="true" />
            <ui:RadioButtonGroup label="Radio Button Group" value="-1" choices="one, two, three" focusable="true" />
            <uie:IntegerField label="Int Field" value="42" focusable="true" />
            <uie:FloatField label="Float Field" value="42.2" focusable="true" style="margin-left: 12px; margin-right: 12px; margin-top: 5px; margin-bottom: 5px;" />
            <uie:LongField label="Long Field" value="42" focusable="true" />
            <ui:SliderInt picking-mode="Ignore" label="SliderInt" value="42" high-value="100" focusable="true" show-input-field="true" style="margin-left: 12px; margin-right: 12px; margin-top: 5px; margin-bottom: 5px;" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
